{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-audio/events/v1",
  "title": "Story Audio worker events (protocol v1)",
  "description": "Mỗi dòng stdout của worker là 1 event JSON hợp chuẩn này (JSON Lines). Log thường đi stderr. Node validate trước khi persist.",
  "type": "object",
  "required": ["protocol", "type", "seq", "job_id"],
  "properties": {
    "protocol": { "const": "1" },
    "type": { "enum": ["stage_started", "progress", "chapter_status", "artifact_ready", "quota_wait", "needs_review", "error", "final"] },
    "seq": { "type": "integer", "minimum": 0, "description": "monotonic per-job, tăng dần, bắt đầu 0" },
    "job_id": { "type": "string", "minLength": 1 }
  },
  "oneOf": [
    {
      "required": ["type", "stage"],
      "properties": { "type": { "const": "stage_started" }, "stage": { "type": "string" } }
    },
    {
      "required": ["type", "stage", "done", "total"],
      "properties": {
        "type": { "const": "progress" },
        "stage": { "type": "string" },
        "done": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    {
      "required": ["type", "chapter_no", "state"],
      "properties": {
        "type": { "const": "chapter_status" },
        "chapter_no": { "type": "integer", "minimum": 1 },
        "state": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    {
      "required": ["type", "path", "kind", "checksum"],
      "properties": {
        "type": { "const": "artifact_ready" },
        "path": { "type": "string", "description": "đường dẫn tương đối bên trong workdir" },
        "kind": { "enum": ["chapter_text", "normalized_text", "rewritten_text", "chapter_audio", "m4b", "mp4", "thumbnail", "description"] },
        "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 hex" }
      }
    },
    {
      "required": ["type", "backend", "not_before"],
      "properties": {
        "type": { "const": "quota_wait" },
        "backend": { "type": "string" },
        "not_before": { "type": "string", "format": "date-time" }
      }
    },
    {
      "required": ["type", "chapter_no", "reason"],
      "properties": {
        "type": { "const": "needs_review" },
        "chapter_no": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string" }
      }
    },
    {
      "required": ["type", "message", "retryable"],
      "properties": {
        "type": { "const": "error" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "stage": { "type": "string" }
      }
    },
    {
      "required": ["type", "status", "summary"],
      "properties": {
        "type": { "const": "final" },
        "status": { "enum": ["success", "failed", "needs_review", "quota_wait"] },
        "summary": { "type": "string" }
      }
    }
  ]
}
