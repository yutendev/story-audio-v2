# Story Audio — local environment (PLACEHOLDER names only — KHÔNG điền giá trị thật ở đây)
# Copy thành .env và điền giá trị local; .env bị gitignore, NEVER commit real values.
# Chi tiết cấu hình: docs/runbooks/dev-setup.md

# PostgreSQL + Prisma (apps/api, T2.x)
DATABASE_URL=

# Local dev Postgres (compose, T2.1) — điền POSTGRES_* để compose dựng container
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# AI Rewrite Providers (T5.x) — Hỗ trợ song song hoặc chuyển đổi linh hoạt:
# 1. OpenRouter (Khuyên dùng: DeepSeek V3, Qwen 2.5, Llama 3 — dồi dào, nhiều model free, không lo nghẽn quota)
#    Lấy API key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=
VIETLAI_OPENROUTER_MODEL=deepseek/deepseek-chat

# 2. Google Gemini Free (gemini-2.0-flash / gemini-1.5-flash)
#    Lấy API key tại: https://aistudio.google.com/
GEMINI_API_KEY=
VIETLAI_GEMINI_MODEL=gemini-2.0-flash

# 3. DevKit AI (Cổng kết nối chuẩn OpenAI) — DeepSeek R1 550B
#    Cổng kết nối chuẩn OpenAI (Base URL): https://agent.devkit.vn/v1
DEVKIT_API_KEY=
DEVKIT_BASE_URL=https://agent.devkit.vn/v1
VIETLAI_DEVKIT_MODEL=deepseek-r1-550b

# Cloudflare R2 — private bucket; credentials owned by Node only (T4.x)
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Python worker (T1.x)
STORY_AUDIO_WORK_ROOT=
